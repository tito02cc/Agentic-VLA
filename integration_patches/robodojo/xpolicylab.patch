+def resolve_semantic_event_reserve(value: Any, max_calls: int) -> int:
+    """Parse an optional event-only tail of the existing semantic call budget."""
+    if value is None or value == "":
+        value = 0
+    if isinstance(value, str) and value.strip().isdigit():
+        value = int(value.strip())
+    if type(value) is not int or not 0 <= value <= max_calls:
+        raise ValueError("semantic event reserve must be an integer within the total call budget")
+    return value
+
+
+def resolve_task_plan_check_schedule(value: Any, max_checks: int, min_gap: int) -> tuple[int, ...]:
+    """Optional absolute control-step schedule within the existing call budget."""
+    if value is None or value == "":
+        return ()
+    if not isinstance(value, str) or any(not part.isdigit() for part in value.split(":")):
+        raise ValueError("task plan check schedule must be colon-separated positive integers")
+    steps = tuple(int(part) for part in value.split(":"))
+    if len(steps) > max_checks or any(b - a < min_gap for a, b in zip((0, *steps), steps)):
+        raise ValueError("task plan schedule exceeds call budget or violates minimum spacing")
+    return steps
+
