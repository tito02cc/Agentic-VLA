+    def _record_native_request(
+        self,
+        *,
+        env_idx: int,
+        payload: dict[str, Any],
+        actions: np.ndarray | None,
+        model_latency_ms: float,
+        error: str | None,
+    ) -> None:
+        """Append one native-path request record in the runtime-trace schema.
+
+        Only the fields the native path can honestly fill are populated. There is
+        no wrapper, queue or deadline here, so those stay null instead of being
+        copied from the request: a null is auditable, an invented zero is not.
+        Recording never changes the action that was already returned, and a
+        logging failure must not abort a robot episode, so it is reported and
+        counted rather than raised.
+        """
+
+        # getattr, not attribute access: partially constructed instances (unit
+        # fixtures, older frozen snapshots) must keep working with tracing off.
+        trace_path = getattr(self, "_native_trace_path", None)
+        if trace_path is None:
+            return
+        try:
+            from agentic_vla.runtime.adapters.starvla import (
+                hash_starvla_request_input,
+                summarize_starvla_request_input,
+            )
+
+            # Which knob the *server* honours, not which key happens to be in the
+            # payload. QwenPI_v3.predict_action pops only "num_inference_steps";
+            # the legacy "num_ddim_steps"/"use_ddim" keys this native payload
+            # carries are swallowed by **kwargs and never reach the flow head. So
+            # the native arm actually runs the checkpoint's configured step count
+            # (server_metadata.native_inference_steps), not the deploy.yml
+            # num_ddim_steps. Reporting the payload value here would have claimed
+            # 10 flow steps for a request that ran 4.
+            server_meta = getattr(self, "_starvla_server_meta", {}) or {}
+            is_pi_v3 = str(server_meta.get("framework", "")).lower() == "qwenpi_v3"
+            steps_key = "num_inference_steps" if is_pi_v3 else "num_ddim_steps"
+            checkpoint_steps = server_meta.get("native_inference_steps")
+            if steps_key in payload:
+                effective_steps = int(payload[steps_key])
+                steps_source = "request"
+            elif is_pi_v3 and checkpoint_steps is not None:
+                effective_steps = int(checkpoint_steps)
+                steps_source = "checkpoint_default"
+            else:
+                effective_steps = int(self.num_ddim_steps)
+                steps_source = "deploy_default"
+            record: dict[str, Any] = {
+                "adapter_id": "starvla-pi-v3-robodojo-native",
+                "policy_family": "vla",
+                "episode_id": int(env_idx),
+                "timestep": int(self.step_by_env.get(env_idx, 0)),
+                "request_id": hashlib.sha256(
+                    f"{getattr(self, '_reset_generation', 0)}:{env_idx}:"
+                    f"{self.step_by_env.get(env_idx, 0)}".encode()
+                ).hexdigest()[:32],
+                # episode_id is the parallel env index, which is 0 for every
+                # single-env evaluation, so it cannot separate one episode from
+                # the next. The reset generation increments on every audited
+                # policy reset, which is what actually delimits episodes.
+                "reset_generation": int(getattr(self, "_reset_generation", 0)),
+                "success": error is None,
+                "error": error,
+                "action_count": None if actions is None else int(actions.shape[0]),
+                "action_age_steps": 0,
+                # Same measurement scope as the adapter: the policy-server call.
+                "model_latency_ms": max(0.0, float(model_latency_ms)),
+                # No CarveRuntime wrapper on this path.
+                "runtime_latency_ms": None,
+                "queue_age_ms": None,
+                "reaction_latency_ms": None,
+                "deadline_ms": None,
+                "deadline_miss": False,
+                "requested_controls": None,
+                "applied_controls": {
+                    "deadline_ms": None,
+                    "inference_steps": effective_steps,
+                    "max_actions": int(self.carve_execute_horizon),
+                    "precision": None,
+                    "reuse_context": False,
+                },
+                "dropped_controls": [],
+                "stage_latencies_ms": {},
+                "task_cycle_latency_ms": None,
+                "metadata": {
+                    "backend": "starvla_websocket",
+                    "path": "native",
+                    "decoding": (
