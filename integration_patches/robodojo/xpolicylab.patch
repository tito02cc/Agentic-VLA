+def resolve_stall_evidence_limits(
+    checkpoint_steps: int,
+    min_stall_override: Any = None,
+    validity_override: Any = None,
+) -> tuple[int, int]:
+    """Resolve the two limits on what may count as long-term-stall evidence.
+
+    A Monitor-forced semantic check is allowed to look at the scene immediately
+    -- that is the point of an event-triggered check -- but it must not be able
+    to manufacture stall evidence faster than the periodic schedule would.
+    Without a minimum interval, two checks three steps apart satisfied
+    ``carve_semantic_stale_checks=2`` and were reported as a long-term stall.
+
+    Returns ``(min_stall_interval_steps, observation_validity_steps)``:
+
+    * ``min_stall_interval_steps`` -- two observations closer than this may not
+      both count toward the stall streak. Defaults to one checkpoint period.
+    * ``observation_validity_steps`` -- an unchanged value only evidences a
+      *continuous* stall while the previous observation is still current. Past
+      this window the streak restarts instead of accumulating across a gap.
+      Defaults to two checkpoint periods, i.e. evidence continuity breaks once
+      more than one scheduled checkpoint has been missed.
+
+    ``None`` or an empty override selects the derived default, so the launcher
+    and the server script never reimplement the derivation and cannot drift
+    from it. ``0`` explicitly disables a limit.
+    """
+
+    unset = (None, "", "null", "none", "None")
+    interval = (
+        int(checkpoint_steps)
+        if min_stall_override in unset
+        else int(min_stall_override)
+    )
+    validity = (
+        2 * int(checkpoint_steps)
+        if validity_override in unset
+        else int(validity_override)
+    )
+    return interval, validity
+
+
+def resolve_min_unchanged_steps(
+    checkpoint_steps: int,
+    stale_checks_required: int,
+    override: Any = None,
