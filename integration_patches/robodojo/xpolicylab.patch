+    def _capture_native_payload(
+        self,
+        record: dict[str, Any],
+        payload: dict[str, Any],
+        actions: np.ndarray | None,
+    ) -> None:
+        """Save one real payload verbatim so it can be replayed in-process.
+
+        Arrays go to an ``.npz`` and every scalar to a manifest line, including
+        the digests already computed for the trace. A replay must rebuild the
+        payload and re-derive the same ``input_sha256``; if it cannot, the replay
+        is not running on the recorded observation and must fail rather than
+        report a comparison on the wrong input.
+
+        Only successful requests are captured: a failed request has no action to
+        compare against.
+        """
+
+        capture_dir = getattr(self, "_native_capture_dir", None)
+        if capture_dir is None or actions is None:
+            return
+        if self._native_capture_count >= self._native_capture_max:
+            return
+        examples = payload.get("examples") or ()
+        if len(examples) != 1:
+            # The adapter contract is one env per request; anything else is not
+            # a payload this replay path knows how to reconstruct.
+            return
+        example = examples[0]
+        images = example.get("image")
+        images = list(images) if isinstance(images, (list, tuple)) else [images]
+
+        index = self._native_capture_count
+        stem = f"payload_{index:04d}"
+        arrays: dict[str, np.ndarray] = {}
+        for view, image in enumerate(images):
+            arrays[f"image_{view}"] = np.ascontiguousarray(np.asarray(image))
+        state = example.get("state")
+        if state is not None:
+            arrays["state"] = np.ascontiguousarray(np.asarray(state))
+        arrays["actions"] = np.ascontiguousarray(actions)
+        np.savez_compressed(capture_dir / f"{stem}.npz", **arrays)
+
+        entry = {
+            "index": index,
+            "arrays": f"{stem}.npz",
+            "image_views": len(images),
+            "has_state": state is not None,
+            "lang": str(example.get("lang", "")),
+            # Everything the server treats as a request-level control.
+            "do_sample": payload.get("do_sample"),
+            "use_ddim": payload.get("use_ddim"),
+            "num_ddim_steps": payload.get("num_ddim_steps"),
+            "num_inference_steps": payload.get("num_inference_steps"),
+            "unnorm_key": payload.get("unnorm_key"),
+            "action_seed": payload.get("action_seed"),
+            # Carried from the trace record so a replay can verify it rebuilt
+            # the same input and reproduce the live run's own output.
+            "input_sha256": record["metadata"]["input_sha256"],
+            "action_sha256": record["metadata"]["action_sha256"],
+            "live_inference_steps": record["metadata"]["inference_steps"],
+            "live_inference_steps_source": record["metadata"][
+                "inference_steps_source"
+            ],
+            "live_model_latency_ms": record["model_latency_ms"],
+            "episode_id": record["episode_id"],
+            "reset_generation": record["reset_generation"],
+            "timestep": record["timestep"],
+        }
+        with (capture_dir / "payload_manifest.jsonl").open(
+            "a", encoding="utf-8"
+        ) as handle:
+            handle.write(json.dumps(entry, sort_keys=True) + "\n")
+        self._native_capture_count = index + 1
+
