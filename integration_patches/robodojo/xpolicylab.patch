+
+    def _with_procedural_context(self, context):
+        memory = getattr(self, "_procedure_memory", None)
+        if memory is None:
+            return context
+        enriched = memory.enrich(context)
+        self._record_planner_row({
+            "schema_version": "carve.robodojo.procedure-retrieval.v1",
+            "timestamp_s": time.time(),
+            "env_idx": context.episode_id,
+            "timestep": context.timestep,
+            "trigger": context.trigger,
+            "action": "retrieve_procedure_context",
+            **memory.receipt(enriched),
+        })
+        return enriched
+
+    def _load_replay_task_plan(
+        self,
+        replay_ticket: dict[str, Any],
+        *,
+        replay_path: Path,
+    ) -> None:
+        """Validate an observation-derived staged plan without evaluator state."""
+
+        from agentic_vla.runtime import ProceduralStep
+        from agentic_vla.runtime.knowledge import reject_privileged_semantic_fields
+
+        raw_plan = replay_ticket.get("task_plan")
+        if raw_plan in (None, {}):
+            decision = replay_ticket.get("decision")
+            proposed_plan = (
+                decision.get("proposed_plan")
+                if isinstance(decision, dict)
+                else None
+            )
+            if not isinstance(proposed_plan, list) or not proposed_plan:
+                return
+            # Accepted planner receipts store their validated stages under
+            # decision.proposed_plan. Treat that canonical receipt as an
+            # unconfirmed task plan so offline planning and online execution
+            # use one artifact instead of a second hand-written wrapper.
+            raw_plan = {
+                "steps": proposed_plan,
+                "confirmed_stages": [],
+                "source": replay_ticket.get("source")
+                or f"accepted_proposed_plan:{replay_path}",
+            }
+        if not isinstance(raw_plan, dict):
+            raise ValueError("planner replay task_plan must be a JSON object")
+        reject_privileged_semantic_fields(raw_plan, path="planner_replay.task_plan")
+        raw_steps = raw_plan.get("steps")
+        if not isinstance(raw_steps, list) or not raw_steps:
+            raise ValueError("planner replay task_plan requires non-empty steps")
+        steps = []
+        for index, raw_step in enumerate(raw_steps):
+            if not isinstance(raw_step, dict):
+                raise ValueError(f"planner replay task_plan step {index} must be an object")
+            constraints = raw_step.get("constraints", [])
+            if not isinstance(constraints, list):
+                raise ValueError(
+                    f"planner replay task_plan step {index} constraints must be a list"
+                )
+            steps.append(
+                ProceduralStep(
+                    stage=str(raw_step.get("stage", "")),
+                    intent=str(raw_step.get("intent", "vla_act")),
+                    subgoal=str(raw_step.get("subgoal", "")),
+                    expected_outcome=str(raw_step.get("expected_outcome", "")),
+                    skill_id=raw_step.get("skill_id"),
+                    constraints=tuple(str(value) for value in constraints),
+                )
+            )
+        confirmed = tuple(
+            str(stage).strip() for stage in raw_plan.get("confirmed_stages", [])
+        )
+        if any(not stage for stage in confirmed):
+            raise ValueError("planner replay confirmed_stages contains an empty stage")
+        stage_order = tuple(step.stage for step in steps)
+        if confirmed != stage_order[: len(confirmed)]:
+            raise ValueError(
+                "planner replay confirmed_stages must be a contiguous plan prefix"
+            )
+        if len(confirmed) >= len(steps):
+            raise ValueError("planner replay task_plan must leave one active stage")
+        self._replay_task_plan_steps = tuple(steps)
+        self._replay_confirmed_stages = confirmed
+        self._replay_task_plan_source = str(
+            raw_plan.get("source") or replay_ticket.get("source") or replay_path
+        )
+
+    def _ensure_replay_task_plan(self, env_idx: int):
+        """Install one monotonic plan ledger per environment on first observation."""
+
+        if not getattr(self, "_replay_task_plan_steps", ()):
+            return None
+        existing = getattr(self, "_task_plan_by_env", {}).get(env_idx)
+        if existing is not None:
+            return existing
+
+        from agentic_vla.toolchain import EmbodiedTaskPlan, VerificationReport
+
+        plan = EmbodiedTaskPlan()
+        plan.install(self._replay_task_plan_steps, available_skills=())
+        for stage in self._replay_confirmed_stages:
+            active = plan.active
+            if active is None or active.step.stage != stage:
+                raise RuntimeError("replay task-plan prefix no longer matches active stage")
+            plan.apply_verification(
+                VerificationReport(
+                    status="confirmed",
+                    observed_outcome=(
+                        f"staged VLM observation marked semantic stage {stage} complete"
+                    ),
+                    confidence=1.0,
+                )
+            )
+        if getattr(self, "_task_plan_mode", "disabled") == "execute":
+            active = plan.active
+            if active is None:
+                raise RuntimeError("replay task plan has no active stage")
+            plan.select(
+                subgoal=active.step.subgoal,
+                intent=active.step.intent,
+                skill_id=active.step.skill_id,
+            )
+            task_instruction = self._task_instruction_by_env[env_idx]
+            self._install_routed_planner_guidance(
+                env_idx,
+                active.step.subgoal,
+                calls=int(getattr(self, "_semantic_guidance_calls", 2)),
+            )
+            self.action_chunks_by_env.pop(env_idx, None)
+        self._task_plan_by_env[env_idx] = plan
+        self._record_planner_row(
+            {
+                "schema_version": "carve.robodojo.planner.v1",
+                "timestamp_s": time.time(),
+                "env_idx": env_idx,
+                "timestep": self.step_by_env.get(env_idx, 0),
+                "trigger": "task_plan_install",
+                "source": self._replay_task_plan_source,
+                "vla_instruction_capability": getattr(
+                    self, "_vla_instruction_capability", "task_only"
+                ),
+                "task_plan": plan.to_dict(),
+            }
+        )
+        return plan
+
+    def _maybe_initialize_online_task_plan(self, env_idx: int) -> None:
+        """Ask the VLM for one bounded symbolic plan without evaluator state."""
+
+        mode = getattr(self, "_task_plan_mode", "disabled")
+        attempted = getattr(self, "_task_plan_attempted_envs", set())
+        if mode == "disabled" or env_idx in attempted:
+            return
+        if env_idx in self._task_plan_by_env or self._high_level_agent is None:
+            return
+        if not hasattr(self, "_task_plan_attempted_envs"):
+            self._task_plan_attempted_envs = set()
+        self._task_plan_attempted_envs.add(env_idx)
+
+        from agentic_vla.runtime import (
+            AgentIntent,
+            HighLevelAgentContext,
+        )
+        from agentic_vla.toolchain import EmbodiedTaskPlan
+
+        observation = self.obs_by_env[env_idx]
+        frames = self._semantic_frames(env_idx)
+        task_instruction = self._task_instruction_by_env[env_idx]
+        context = HighLevelAgentContext(
+            task_instruction=task_instruction,
+            trigger="task_start",
+            episode_id=env_idx,
+            timestep=self.step_by_env.get(env_idx, 0),
+            frames=frames,
+            robot_state=tuple(
+                np.asarray(observation.get("state", ()), dtype=np.float32)
+                .reshape(-1)
+                .tolist()
+            ),
+            current_subgoal=task_instruction,
+            memory=tuple(self._agent_memory_by_env.get(env_idx, ())),
+            allowed_intents=(AgentIntent.VLA_ACT, AgentIntent.SAFE_STOP),
+            remaining_retries=max(
+                0,
+                int(self.model_cfg.get("carve_planner_max_calls_per_episode", 3))
+                - self._high_level_agent.calls_in_episode,
+            ),
+            remaining_recoveries=self._semantic_max_recoveries,
+        )
+        context = self._with_procedural_context(context)
+        result = self._high_level_agent.decide(context)
+        decision = result.decision
+        action = "task_plan_rejected_fallback_original"
+        plan = None
+        if (
+            result.accepted
+            and decision.intent is AgentIntent.VLA_ACT
+            and decision.proposed_plan
+        ):
+            plan = EmbodiedTaskPlan()
+            plan.install(decision.proposed_plan, available_skills=())
+            action = "task_plan_shadow_recorded"
+            if mode == "execute":
+                plan.select(
+                    subgoal=decision.subgoal,
+                    intent=decision.intent.value,
+                    skill_id=decision.skill_id,
+                )
+                self._task_plan_by_env[env_idx] = plan
+                self._install_routed_planner_guidance(
+                    env_idx,
+                    str(decision.vla_instruction),
+                    calls=int(getattr(self, "_semantic_guidance_calls", 2)),
+                )
+                self.action_chunks_by_env.pop(env_idx, None)
+                action = "task_plan_installed"
+            elif getattr(self, "_inspection_shadow", False):
+                self._task_plan_by_env[env_idx] = plan
+
+        self._record_planner_row(
+            {
+                "schema_version": "carve.robodojo.task-plan.v1",
+                "timestamp_s": time.time(),
+                "env_idx": env_idx,
+                "timestep": self.step_by_env.get(env_idx, 0),
+                "trigger": "task_start",
+                "mode": mode,
+                "vla_instruction_capability": self._vla_instruction_capability,
+                "accepted": result.accepted,
+                "elapsed_ms": result.elapsed_ms,
+                "attempt_count": result.attempt_count,
+                "decision": decision.to_dict(),
+                "action": action,
+                "task_plan": plan.to_dict() if plan is not None else {},
+                "error": result.error,
+                "validation_errors": list(result.validation_errors),
+                "raw_output": result.raw_output,
+            }
+        )
+
+    def _task_plan_group_predicate(self, env_idx: int, plan: Any):
+        """Compile a known stack plan into a Harness-owned observable predicate."""
+
+        from agentic_vla.toolchain import ScalarVisualPredicate
+
+        task = self._task_instruction_by_env.get(env_idx, "").strip().lower()
+        plan_rows = plan.to_dict().get("steps", [])
+        active = plan.active
+        if (
+            active is None
+            or "stack" not in task
+            or "bowl" not in task
+            or not ("three" in task or "3" in task)
+            or len(plan_rows) != 2
+            or any("stack" not in str(row.get("subgoal", "")).lower() for row in plan_rows)
+        ):
+            return None
+        active_index = next(
+            (
+                index
+                for index, row in enumerate(plan_rows)
+                if row.get("stage") == active.step.stage
+            ),
+            None,
+        )
+        if active_index is None:
+            return None
+        # Three separate bowls start as three groups. A correct two-stage stack
+        # reduces that observable count to two, then one.
+        return ScalarVisualPredicate(
+            predicate_id="three_bowl_stack_groups",
+            question=(
+                "Enumerate every spatially separate group formed by the three target "
+                "bowls. Bowls nested or touching as one stack are one group."
+            ),
+            comparison="eq",
+            target=float(2 - active_index),
+            unit="groups",
+            minimum_valid_value=1.0,
+            maximum_valid_value=3.0,
+        )
+
+    def _initialize_inspection_shadow(self, infer, source: str) -> None:
+        from agentic_vla.toolchain import RunManifest, RunWorkspace
+        from agentic_vla.toolchain.inspection_verifier import InspectingProgressVerifier
+
+        if getattr(infer, "max_images", 2) < 2:
+            raise ValueError("inspection shadow requires room for full frame and crop")
+        workspace = RunWorkspace(
+            self._planner_trace_path.parent / f"{self._planner_trace_path.stem}_inspection",
+            RunManifest(
+                run_id=self._planner_trace_path.stem,
+                environment_id="RoboDojo", task_id="runtime_inspection_shadow",
+                seed=int(getattr(self, "action_seed_base", None) or 0),
+                planner_id=source, policy_id="StarVLA", deployment_profile_id="inspection_shadow",
+                metadata={"source_trace": str(self._planner_trace_path),
+                          "seed_kind": "action_seed_base_or_zero_not_layout_seed"},
+            ),
+        )
+        self._inspection_progress_verifier = InspectingProgressVerifier(infer, workspace)
+
+    def _apply_inspection_shadow(self, env_idx: int) -> bool:
+        """Record model-selected visual checks without advancing plans or actions."""
+        verifier = getattr(self, "_inspection_progress_verifier", None)
+        if not getattr(self, "_inspection_shadow", False) or verifier is None:
+            return False
+        if self._task_plan_mode != "shadow":
+            raise RuntimeError("inspection is not admitted for task-plan execution")
+        plan = self._task_plan_by_env.get(env_idx)
+        if plan is None:
+            return False
+        step = self.step_by_env.get(env_idx, 0)
+        last = self._task_plan_last_check_by_env.get(env_idx, 0)
+        count = self._task_plan_checks_by_env.get(env_idx, 0)
+        if step - last < self._task_plan_checkpoint_steps or count >= self._task_plan_max_checks:
+            return False
+        from agentic_vla.toolchain import ToolExecutionContext, VisualProgressContext, VisualStagePredicate
+
+        observation = self.obs_by_env[env_idx]
+        plan_fingerprint = json.dumps(plan.to_dict(), sort_keys=True)
+        generation = getattr(self, "_reset_generation", 0)
+        context = ToolExecutionContext(
+            f"reset{generation}:env{env_idx}", step, True, ("inspect_region",),
+            deployment_profile_id="inspection_shadow",
+        )
+
+        def current_context():
+            if (
+                getattr(self, "_reset_generation", 0) != generation
+                or self.obs_by_env.get(env_idx) is not observation
+                or self.step_by_env.get(env_idx, 0) != step
+                or self._task_plan_by_env.get(env_idx) is not plan
+                or json.dumps(plan.to_dict(), sort_keys=True) != plan_fingerprint
+            ):
+                raise ValueError("RoboDojo observation, plan, or episode changed during inspection")
+            return context
+
+        self._task_plan_last_check_by_env[env_idx] = step
+        self._task_plan_checks_by_env[env_idx] = count + 1
+        result = verifier.verify(
+            VisualProgressContext(
+                self._task_instruction_by_env[env_idx],
+                tuple(VisualStagePredicate(row["stage"], row["expected_outcome"])
+                      for row in plan.to_dict()["steps"]),
+                self._semantic_frames(env_idx, current=True, head_only=True),
+            ),
+            execution_context=context, current_context=current_context,
+        )
+        self._record_planner_row({
+            "event": "inspection_progress_shadow", "env_idx": env_idx, "timestep": step,
+            "accepted": result.accepted, "confirmed_prefix": list(result.confirmed_prefix),
+            "reports": {name: report.to_dict() for name, report in result.reports.items()},
+            "error": result.error, "elapsed_ms": result.elapsed_ms,
+            "control_applied": False, "memory_written": False,
+        })
+        return True
+
+    def _task_plan_for_execution(self, env_idx: int):
+        if getattr(self, "_inspection_shadow", False):
+            return None
+        return getattr(self, "_task_plan_by_env", {}).get(env_idx)
+
+    def _apply_task_plan_checkpoint(self, env_idx: int) -> bool:
+        """Verify and advance one Harness-owned semantic stage at a safe boundary."""
+
+        if getattr(self, "_task_plan_mode", "disabled") != "execute":
+            return False
+        if env_idx in self._task_plan_abandoned_envs:
+            return False
+        plan = self._task_plan_for_execution(env_idx)
+        critic = getattr(self, "_task_plan_visual_critic", None)
+        grouped_critic = getattr(self, "_task_plan_grouped_visual_critic", None)
+        if plan is None or plan.active is None or critic is None:
+            return False
+        step = self.step_by_env.get(env_idx, 0)
+        last_check = self._task_plan_last_check_by_env.get(env_idx, 0)
+        if (
+            step < self._task_plan_checkpoint_steps
+            or step - last_check < self._task_plan_checkpoint_steps
+        ):
+            return False
+        checks = self._task_plan_checks_by_env.get(env_idx, 0)
+        if checks >= self._task_plan_max_checks:
+            return False
+        schedule = getattr(self, "_task_plan_check_schedule", ())
+        if schedule and (checks >= len(schedule) or step < schedule[checks]):
+            return False
+
+        from agentic_vla.toolchain import VerificationStatus, VisualVerificationContext
+
+        observation = self.obs_by_env[env_idx]
+        frames = self._semantic_frames(env_idx, current=True)
+        if not frames:
+            return False
+        active_before = plan.active
+        assert active_before is not None
+        plan_before = plan.to_dict()
+        self._task_plan_last_check_by_env[env_idx] = step
+        self._task_plan_checks_by_env[env_idx] = checks + 1
+        verification_context = VisualVerificationContext(
+            task_instruction=self._task_instruction_by_env[env_idx],
+            expected_outcome=active_before.step.expected_outcome,
+            frames=frames,
+            timestep=step,
+            active_stage=active_before.step.stage,
+        )
+        grouped_predicate = self._task_plan_group_predicate(env_idx, plan)
+        if grouped_predicate is not None and grouped_critic is not None:
+            # Group enumeration must use one canonical view. Combining head and
+            # wrist images makes the same physical object appear as several groups.
+            grouped_context = dataclasses.replace(
+                verification_context,
+                frames=self._semantic_frames(env_idx, current=True, head_only=True),
+            )
+            result = grouped_critic.verify(grouped_context, grouped_predicate)
+            verification_mode = "harness_group_count"
+            verification_frames = list(grouped_context.frames)
+        else:
+            result = critic.verify(verification_context)
+            verification_mode = "guarded_free_form"
+            verification_frames = list(verification_context.frames)
+        report = result.report
+        action = "task_plan_observe_only"
+        changed_execution = False
+        contradiction_streak = 0
+        protocol_failure_streak = 0
+        if result.accepted and report.status is VerificationStatus.CONFIRMED:
+            getattr(self, "_task_plan_protocol_failures_by_env", {}).pop(
+                env_idx, None
+            )
+            getattr(self, "_task_plan_contradiction_streak_by_env", {}).pop(
+                env_idx, None
+            )
+            plan.apply_verification(report)
+            next_step = plan.active
+            if next_step is None:
+                self._semantic_guidance_remaining_by_env.pop(env_idx, None)
+                self._semantic_guidance_instruction_by_env.pop(env_idx, None)
+                observation["lang"] = self._task_instruction_by_env[env_idx]
+                action = "task_plan_complete_ledger_only"
+            else:
+                plan.select(
+                    subgoal=next_step.step.subgoal,
+                    intent=next_step.step.intent,
+                    skill_id=next_step.step.skill_id,
+                )
+                self._install_routed_planner_guidance(
+                    env_idx,
+                    next_step.step.subgoal,
+                    calls=int(getattr(self, "_semantic_guidance_calls", 2)),
+                )
+                action = "task_plan_advance_ledger_only"
+            if self._vla_instruction_capability == "open_vocab_subgoal":
+                self.action_chunks_by_env.pop(env_idx, None)
+                self._arm_recovery_compute(env_idx)
+                action = (
+                    "task_plan_complete_continue_original"
+                    if next_step is None
+                    else "task_plan_advance"
+                )
+                changed_execution = True
+        elif result.accepted and report.status is VerificationStatus.CONTRADICTED:
+            getattr(self, "_task_plan_protocol_failures_by_env", {}).pop(
+                env_idx, None
+            )
+            streaks = getattr(
+                self, "_task_plan_contradiction_streak_by_env", None
+            )
+            if streaks is None:
+                streaks = {}
+                self._task_plan_contradiction_streak_by_env = streaks
+            previous_stage, previous_count = streaks.get(env_idx, ("", 0))
+            contradiction_streak = (
+                previous_count + 1
+                if previous_stage == active_before.step.stage
+                else 1
+            )
+            streaks[env_idx] = (active_before.step.stage, contradiction_streak)
+            required = int(getattr(self, "_task_plan_stale_checks_required", 2))
+            if contradiction_streak < required:
+                action = "task_plan_contradiction_observed"
+            else:
+                retriable = (
+                    active_before.attempts < self._task_plan_max_attempts_per_stage
+                )
+                plan.apply_verification(report)
+                if retriable:
+                    retry_step = plan.active
+                    assert retry_step is not None
+                    plan.select(
+                        subgoal=retry_step.step.subgoal,
+                        intent=retry_step.step.intent,
+                        skill_id=retry_step.step.skill_id,
+                    )
+                    self._install_routed_planner_guidance(
+                        env_idx,
+                        retry_step.step.subgoal,
+                        calls=int(getattr(self, "_semantic_guidance_calls", 2)),
+                    )
+                    self.action_chunks_by_env.pop(env_idx, None)
+                    self._arm_recovery_compute(env_idx)
+                    action = "task_plan_retry_active_stage"
+                    changed_execution = True
+                else:
+                    self._task_plan_abandoned_envs.add(env_idx)
+                    self._semantic_guidance_remaining_by_env.pop(env_idx, None)
+                    self._semantic_guidance_instruction_by_env.pop(env_idx, None)
+                    observation["lang"] = self._task_instruction_by_env[env_idx]
+                    action = "task_plan_retry_exhausted_fallback_original"
+        elif not result.accepted:
+            failures = getattr(self, "_task_plan_protocol_failures_by_env", None)
+            if failures is None:
+                failures = {}
+                self._task_plan_protocol_failures_by_env = failures
+            protocol_failure_streak = failures.get(env_idx, 0) + 1
+            failures[env_idx] = protocol_failure_streak
+            if protocol_failure_streak >= int(
+                getattr(self, "_task_plan_max_protocol_failures", 1)
+            ):
+                self._task_plan_abandoned_envs.add(env_idx)
+                self._semantic_guidance_remaining_by_env.pop(env_idx, None)
+                self._semantic_guidance_instruction_by_env.pop(env_idx, None)
+                observation["lang"] = self._task_instruction_by_env[env_idx]
+                action = "task_plan_verifier_unavailable_fallback_original"
+            getattr(self, "_task_plan_contradiction_streak_by_env", {}).pop(
+                env_idx, None
+            )
+        else:
+            getattr(self, "_task_plan_protocol_failures_by_env", {}).pop(
+                env_idx, None
+            )
+            getattr(self, "_task_plan_contradiction_streak_by_env", {}).pop(
+                env_idx, None
+            )
+
+        self._record_planner_row(
+            {
+                "schema_version": "carve.robodojo.task-plan-verification.v1",
+                "timestamp_s": time.time(),
+                "env_idx": env_idx,
+                "timestep": step,
+                "trigger": "scheduled_task_plan_checkpoint",
+                "check_schedule": list(schedule),
+                "check_budget_used": checks + 1,
+                "vla_instruction_capability": self._vla_instruction_capability,
+                "verification_mode": verification_mode,
+                "verifier_source": getattr(
+                    self, "_task_plan_verifier_source", "unknown"
+                ),
+                "verification_frames": verification_frames,
+                "semantic_image_profile": getattr(self, "_semantic_image_profile", "vla_224"),
+                "verification_frame_shapes": {
+                    name: list(frames[name].shape) for name in verification_frames
+                },
+                "predicate": (
+                    dataclasses.asdict(grouped_predicate)
+                    if grouped_predicate is not None
+                    else None
+                ),
+                "accepted": result.accepted,
+                "elapsed_ms": result.elapsed_ms,
+                "report": report.to_dict(),
+                "action": action,
+                "contradiction_streak": contradiction_streak,
+                "contradiction_streak_required": int(
+                    getattr(self, "_task_plan_stale_checks_required", 2)
+                ),
+                "protocol_failure_streak": protocol_failure_streak,
+                "protocol_failure_limit": int(
+                    getattr(self, "_task_plan_max_protocol_failures", 1)
+                ),
+                "task_plan_before": plan_before,
+                "task_plan_after": plan.to_dict(),
+                "error": result.error,
+                "raw_output": result.raw_output,
+            }
+        )
+        return changed_execution
+
+    def _record_shadow_risk(self, env_idx: int, action_age: int):
+        if self._monitor_trace_path is None or env_idx not in self._last_action_by_env:
+            return None
+        observation = self.obs_by_env[env_idx]
+        state = np.asarray(observation.get("state"), dtype=np.float32).reshape(-1, self.action_dim)[-1]
+        previous_action = self._last_action_by_env[env_idx]
+        command_residual = previous_action - state
+        images = observation.get("image", [])
+        frame = images[0] if images else None
+        monitor = self._risk_monitors.setdefault(env_idx, self._monitor_factory())
+        assessment = monitor.update(
+            proprio=state,
+            commanded_action=command_residual,
+            frame=frame,
+            action_age_steps=action_age,
+        )
+        row = {
+            "schema_version": "carve.robodojo.monitor.v1",
+            "timestamp_s": time.time(),
+            "condition": (
+                "shadow_no_intervention"
+                if self.carve_mode == "shadow"
+                else "agentic_intervention"
+            ),
+            "env_idx": env_idx,
+            "timestep": self.step_by_env.get(env_idx, 0),
+            "assessment": assessment.to_dict(),
+        }
+        with self._monitor_trace_path.open("a", encoding="utf-8") as handle:
+            handle.write(json.dumps(row, sort_keys=True))
+            handle.write("\n")
+        return assessment
+
+    def _record_planner_row(self, row: dict[str, Any]) -> None:
+        if self._planner_trace_path is None:
+            return
+        row = dict(row)
+        generation = getattr(self, "_reset_generation", None)
+        if isinstance(generation, int) and generation > 0:
+            row["policy_reset_generation"] = generation
+        with self._planner_trace_path.open("a", encoding="utf-8") as handle:
+            handle.write(json.dumps(row, sort_keys=True))
+            handle.write("\n")
+
+    def _apply_agentic_progress_check(self, env_idx: int, risk: Any) -> None:
+        if (
+            self._high_level_agent is None
+            and self._visual_critic is None
+        ) or env_idx in self._safe_stop_envs:
+            return
+        if env_idx in getattr(self, "_high_level_agent_disabled_envs", set()):
+            return
+        if risk.event != "no_progress":
+            return
+
+        step = self.step_by_env.get(env_idx, 0)
+        event_streak = int(risk.evidence.get("event_streak", 0))
+        if event_streak == 1:
+            self.action_chunks_by_env.pop(env_idx, None)
+            self._record_planner_row(
+                {
+                    "schema_version": "carve.robodojo.planner.v1",
+                    "timestamp_s": time.time(),
+                    "env_idx": env_idx,
+                    "timestep": step,
+                    "trigger": "no_progress",
+                    "action": "fresh_vla_replan",
+                    "risk": risk.to_dict(),
+                }
+            )
+            return
+        if event_streak < 2:
+            return
+        last_call = self._last_planner_step_by_env.get(env_idx, -self._planner_cooldown_steps)
+        if step - last_call < self._planner_cooldown_steps:
+            return
+
+        if self._semantic_role == "critic":
+            if getattr(self, "_semantic_predicate", None) is not None:
+                self._apply_scalar_semantic_checkpoint(
+                    env_idx,
+                    trigger="motion_no_progress",
+                    force=True,
+                )
+                return
+            self._apply_visual_critic(env_idx, risk)
+            return
+
+        from agentic_vla.runtime import (
+            AgentIntent,
+            HighLevelAgentContext,
+        )
+
+        observation = self.obs_by_env[env_idx]
+        frames = self._semantic_frames(env_idx)
+        instruction = getattr(self, "_task_instruction_by_env", {}).get(
+            env_idx,
+            str(observation.get("lang", "")),
+        )
+        task_plan = self._task_plan_for_execution(env_idx)
+        context = HighLevelAgentContext(
+            task_instruction=instruction,
+            trigger="no_progress",
+            episode_id=env_idx,
+            timestep=step,
+            frames=frames,
+            robot_state=tuple(
+                np.asarray(observation.get("state"), dtype=np.float32)
+                .reshape(-1, self.action_dim)[-1]
+                .tolist()
+            ),
+            risk=risk.to_dict(),
+            current_subgoal=(
+                task_plan.active.step.subgoal
+                if task_plan is not None and task_plan.active is not None
+                else instruction
+            ),
+            failure_history=tuple(self._agent_memory_by_env.get(env_idx, ())),
+            memory=tuple(self._agent_memory_by_env.get(env_idx, ())),
+            allowed_intents=(AgentIntent.CONTINUE, AgentIntent.VLA_ACT, AgentIntent.SAFE_STOP),
+            remaining_retries=max(0, 3 - self._high_level_agent.calls_in_episode),
+            remaining_recoveries=0,
+            task_plan=(
+                task_plan.to_dict() if task_plan is not None else {}
+            ),
+        )
+        self._last_planner_step_by_env[env_idx] = step
+        context = self._with_procedural_context(context)
+        result = self._high_level_agent.decide(context)
+        decision = result.decision
+        memory_note = (
+            f"step={step} trigger=no_progress intent={decision.intent.value} "
+            f"accepted={result.accepted} subgoal={decision.subgoal} "
+            f"failure_type={decision.failure_type} rationale={decision.rationale} "
+            f"planner_note={decision.memory_note}"
+        )
+        self._agent_memory_by_env.setdefault(env_idx, []).append(memory_note)
+        control_action = "planner_unavailable_continue_original"
+        if (
+            decision.intent is AgentIntent.VLA_ACT
+            and result.accepted
+            and self._recovery_pending_or_exhausted(env_idx)
+        ):
+            control_action = "planner_replan_rejected_recovery_budget"
+        elif decision.intent is AgentIntent.VLA_ACT and result.accepted:
+            control_action = "planner_vla_replan"
+            if task_plan is not None:
+                task_plan.select(
+                    subgoal=decision.subgoal,
+                    intent=decision.intent.value,
+                    skill_id=decision.skill_id,
+                )
+            self._install_routed_planner_guidance(
+                env_idx,
+                str(decision.vla_instruction),
+                calls=int(getattr(self, "_semantic_guidance_calls", 2)),
+            )
+            self.action_chunks_by_env.pop(env_idx, None)
+            self._arm_recovery_compute(env_idx, expected_outcome=decision.expected_outcome)
+            getattr(self, "_fault_recovered_envs", set()).add(env_idx)
+            getattr(self, "_task_plan_last_check_by_env", {})[env_idx] = step
+        elif decision.intent is AgentIntent.CONTINUE and result.accepted:
+            control_action = "planner_continue_original"
+        elif (
+            decision.intent is AgentIntent.SAFE_STOP
+            and result.accepted
+            and bool(getattr(self, "_semantic_safe_stop_enabled", False))
+        ):
+            control_action = "planner_safe_stop_admitted"
+            self._safe_stop_envs.add(env_idx)
+        elif decision.intent is AgentIntent.SAFE_STOP and result.accepted:
+            control_action = "planner_safe_stop_rejected_no_authority"
+            observation["lang"] = instruction
+        else:
+            getattr(self, "_high_level_agent_disabled_envs", set()).add(env_idx)
+            observation["lang"] = instruction
+        self._record_planner_row(
+            {
+                "schema_version": "carve.robodojo.planner.v1",
+                "timestamp_s": time.time(),
+                "env_idx": env_idx,
+                "timestep": step,
+                "trigger": "no_progress",
+                "accepted": result.accepted,
+                "elapsed_ms": result.elapsed_ms,
+                "attempt_count": result.attempt_count,
+                "decision": decision.to_dict(),
+                "error": result.error,
+                "validation_errors": list(result.validation_errors),
+                "raw_output": result.raw_output,
+                "control_action": control_action,
+                "memory_before": list(context.memory),
+                "memory_after": list(self._agent_memory_by_env.get(env_idx, ())),
+                "task_plan_before": dict(context.task_plan),
+                "task_plan_after": (
+                    task_plan.to_dict() if task_plan is not None else {}
+                ),
+            }
+        )
+        self._risk_monitors[env_idx].reset()
+
+    def _reset_scalar_stall_evidence(self, env_idx: int) -> None:
+        """Break evidence continuity without reopening the call schedule."""
+        self._semantic_stale_checks_by_env[env_idx] = 0
+        self._semantic_last_value_by_env.pop(env_idx, None)
+        getattr(self, "_semantic_unchanged_since_step_by_env", {}).pop(env_idx, None)
+
+    def _apply_scalar_semantic_checkpoint(
+        self,
+        env_idx: int,
+        *,
+        trigger: str = "periodic_semantic_checkpoint",
+        force: bool = False,
+    ) -> bool:
+        """Recover only after a VLM-extracted task scalar stays unchanged."""
+
+        if (
+            getattr(self, "_semantic_predicate", None) is None
+            or getattr(self, "_visual_critic", None) is None
+        ):
+            return False
+        if env_idx in self._safe_stop_envs:
+            return False
+        step = self.step_by_env.get(env_idx, 0)
+        last_check = self._semantic_last_check_by_env.get(env_idx)
+        if last_check is not None and step <= last_check:
+            return False
+        # getattr, not attribute access: unit fixtures build Model via __new__
+        # and older frozen snapshots predate this container.
+        if getattr(self, "_semantic_last_counted_step_by_env", None) is None:
+            self._semantic_last_counted_step_by_env = {}
+        # Scheduling is separate from evidence counting. An early forced look
+        # does not shift the periodic slot; a look when that slot is due serves
+        # both triggers. Record clocks only when a real call is admitted.
+        last_counted = self._semantic_last_counted_step_by_env.get(env_idx)
+        if getattr(self, "_semantic_last_periodic_step_by_env", None) is None:
+            self._semantic_last_periodic_step_by_env = {}
+        last_periodic = self._semantic_last_periodic_step_by_env.get(env_idx)
+        schedule_reference = 0 if last_periodic is None else last_periodic
+        periodic_due = (
+            step >= self._semantic_checkpoint_steps
+            and step - schedule_reference >= self._semantic_checkpoint_steps
+        )
+        if not force and not periodic_due:
+            return False
+        if force:
+            last_escalation = getattr(self, "_last_planner_step_by_env", {}).get(env_idx)
+            if last_escalation is not None and (
+                step - last_escalation < getattr(self, "_planner_cooldown_steps", 128)
+            ):
+                return False
+        max_calls = getattr(
+            self,
+            "_semantic_max_calls_per_episode",
+            int(self.model_cfg.get("carve_planner_max_calls_per_episode", 3)),
+        )
+        calls = self._semantic_calls_by_env.get(env_idx, 0)
+        if calls >= max_calls:
+            return False
+        event_reserve = getattr(self, "_semantic_event_reserve_calls", 0)
+        if not force and max_calls - calls <= event_reserve:
+            return False
+
+        from agentic_vla.toolchain import (
+            VerificationStatus,
+            VisualVerificationContext,
+        )
+
+        observation = self.obs_by_env[env_idx]
+        frames = self._semantic_frames(env_idx, current=True, head_only=True)
+        if not frames:
+            return False
+        task_instruction = self._task_instruction_by_env.get(
+            env_idx,
+            str(observation.get("lang", "")),
+        )
+
+        # Scheduling decisions are made before the call and recorded with it, so
+        # an auditor can see why an observation did or did not count.
+        min_stall_interval = getattr(self, "_semantic_min_stall_interval_steps", 0)
+        validity_steps = getattr(self, "_semantic_observation_validity_steps", 0)
+        if last_counted is None:
+            steps_since_counted = None
+            counts_toward_stall = True
+        else:
+            steps_since_counted = step - last_counted
+            counts_toward_stall = steps_since_counted >= min_stall_interval
+        # An expired previous observation cannot be compared against: treat the
+        # new one as the start of a streak rather than its continuation.
+        previous_expired = bool(
+            validity_steps > 0
+            and steps_since_counted is not None
+            and steps_since_counted > validity_steps
+        )
+        if previous_expired:
+            self._reset_scalar_stall_evidence(env_idx)
+
+        if periodic_due:
+            self._semantic_last_periodic_step_by_env[env_idx] = step
+        if force:
+            # This clock already covers Planner/visual-Critic escalations; a
+            # scalar-Critic call must consume the same cooldown even if it does
+            # not request recovery. The container is part of the reset contract.
+            if getattr(self, "_last_planner_step_by_env", None) is None:
+                self._last_planner_step_by_env = {}
+            self._last_planner_step_by_env[env_idx] = step
+        self._semantic_last_check_by_env[env_idx] = step
+        if counts_toward_stall:
+            self._semantic_last_counted_step_by_env[env_idx] = step
+        self._semantic_calls_by_env[env_idx] = calls + 1
+        result = self._visual_critic.verify(
+            VisualVerificationContext(
+                task_instruction=task_instruction,
+                expected_outcome="the configured visual task predicate is satisfied",
+                frames=frames,
+                timestep=step,
+                active_stage="measure configured task progress predicate",
+            ),
+            self._semantic_predicate,
+        )
+        report = result.report
+        value = report.metadata.get("observed_value")
+        stale_checks = 0
+        unchanged_span: int | None = None
+        action = "observe_only"
+        recovery_dispatched = False
+        if (
+            result.accepted
+            and (
+                report.status is VerificationStatus.CONTRADICTED
+                or getattr(self, "_semantic_progress_only", False)
+            )
+            and value is not None
+        ):
+            value = float(value)
+            previous = self._semantic_last_value_by_env.get(env_idx)
+            tolerance = max(1e-6, float(self._semantic_predicate.tolerance))
+            unchanged = previous is not None and abs(previous - value) <= tolerance
+            # Track the span, not just the count. A coarse predicate (integer
+            # group count, target 1) changes only a couple of times per episode,
+            # so "unchanged across two checks" is weak evidence on its own and
+            # gets weaker the more often you look.
+            if getattr(self, "_semantic_unchanged_since_step_by_env", None) is None:
+                self._semantic_unchanged_since_step_by_env = {}
+            if not unchanged or previous_expired:
+                self._semantic_unchanged_since_step_by_env[env_idx] = step
+            unchanged_since = self._semantic_unchanged_since_step_by_env.setdefault(
+                env_idx, step
+            )
+            unchanged_span = step - unchanged_since
+            if not counts_toward_stall:
+                # Observed and recorded, but too close to the previous counted
+                # observation to add evidence. A change still breaks the streak.
+                stale_checks = (
+                    self._semantic_stale_checks_by_env.get(env_idx, 0)
+                    if unchanged else 0
+                )
+            elif unchanged:
+                stale_checks = self._semantic_stale_checks_by_env.get(env_idx, 0) + 1
+            else:
+                stale_checks = 1
+            # The latest value is always the freshest reading, so store it even
+            # when it did not advance the streak; expiry above already dropped a
+            # value that was too old to compare against.
+            self._semantic_last_value_by_env[env_idx] = value
+            self._semantic_stale_checks_by_env[env_idx] = stale_checks
+            recoveries = self._semantic_recoveries_by_env.get(env_idx, 0)
+            deadline_incomplete = bool(
+                getattr(self, "_semantic_deadline_step", 0) > 0
+                and step >= self._semantic_deadline_step
+                and report.status is VerificationStatus.CONTRADICTED
+            )
+            # A stall recovery needs evidence that counted; a deadline recovery
+            # does not, because a missed deadline is not stall evidence.
+            min_unchanged = getattr(self, "_semantic_min_unchanged_steps", 0)
+            stall_reached = (
+                counts_toward_stall
+                and stale_checks >= self._semantic_stale_checks_required
+                and unchanged_span >= min_unchanged
+            )
+            if (
+                (stall_reached or deadline_incomplete)
+                and recoveries < self._semantic_max_recoveries
+            ):
+                recovery_trigger = (
+                    "semantic_deadline_incomplete"
+                    if deadline_incomplete
+                    else trigger
+                )
+                action = self._apply_semantic_recovery(
+                    env_idx,
+                    trigger=recovery_trigger,
+                    report=report,
+                    observed_value=value,
+                    recoveries=recoveries,
+                )
+                recovery_dispatched = action in {
+                    "task_preserving_vla_replan",
+                    "semantic_subgoal_vla_replan",
+                    "semantic_subgoal_blocked_task_only_replan",
+                    "semantic_planner_fallback_replan",
+                }
+                if recovery_dispatched:
+                    self.action_chunks_by_env.pop(env_idx, None)
+                    self._arm_recovery_compute(env_idx)
+                    self._semantic_recoveries_by_env[env_idx] = recoveries + 1
+                self._reset_scalar_stall_evidence(env_idx)
+                self._agent_memory_by_env.setdefault(env_idx, []).append(
+                    f"step={step} trigger={recovery_trigger} "
+                    f"predicate={self._semantic_predicate.predicate_id} value={value} "
+                    f"action={action} recovery_dispatched={recovery_dispatched}"
+                )
+        else:
+            # Unknown, rejected and completed observations cannot bridge two
+            # otherwise separate periods into a continuous stall.
+            self._reset_scalar_stall_evidence(env_idx)
+
+        self._record_planner_row(
+            {
+                "schema_version": "carve.robodojo.scalar-critic.v1",
+                "timestamp_s": time.time(),
+                "env_idx": env_idx,
+                "timestep": step,
+                "trigger": trigger,
+                "role": "scalar_visual_critic",
+                "progress_only": getattr(self, "_semantic_progress_only", False),
+                "accepted": result.accepted,
+                "elapsed_ms": result.elapsed_ms,
+                "predicate": dataclasses.asdict(self._semantic_predicate),
+                "report": report.to_dict(),
+                "stale_checks": stale_checks,
+                # Scheduling audit: whether this observation was allowed to be
+                # long-term-stall evidence, and why.
+                "forced": bool(force),
+                "event_reserve_calls": event_reserve,
+                "call_budget_remaining_before": max_calls - calls,
+                "call_budget_remaining_after": max_calls - calls - 1,
+                "counts_toward_stall": bool(counts_toward_stall),
+                "steps_since_counted_observation": steps_since_counted,
+                "min_stall_interval_steps": min_stall_interval,
+                "observation_validity_steps": validity_steps,
+                "previous_observation_expired": previous_expired,
+                # Span-based stall evidence, so a reviewer can see whether the
+                # predicate really stood still or was merely sampled twice.
+                "unchanged_span_steps": unchanged_span,
+                "min_unchanged_steps": getattr(
+                    self, "_semantic_min_unchanged_steps", 0
+                ),
+                "deadline_step": getattr(self, "_semantic_deadline_step", 0),
+                "deadline_incomplete": bool(
+                    "deadline_incomplete" in locals() and deadline_incomplete
+                ),
+                "action": action,
+                "recovery_dispatched": recovery_dispatched,
+                "error": result.error,
+                "raw_output": result.raw_output,
+            }
+        )
+        return recovery_dispatched
+
+    def _apply_semantic_recovery(
+        self,
+        env_idx: int,
+        *,
+        trigger: str,
+        report: Any,
+        observed_value: float,
+        recoveries: int,
+    ) -> str:
+        """Turn verified semantic stagnation into a guarded VLA subgoal."""
+
+        if (
+            getattr(self, "_semantic_recovery_mode", "task_preserving") != "planner"
+            or getattr(self, "_high_level_agent", None) is None
+        ):
+            return "task_preserving_vla_replan"
+
+        from agentic_vla.runtime import (
+            AgentIntent,
+            HighLevelAgentContext,
+        )
+
+        observation = self.obs_by_env[env_idx]
+        task_instruction = self._task_instruction_by_env.get(
+            env_idx,
+            str(observation.get("lang", "")),
+        )
+        frames = self._semantic_frames(env_idx, current=True, head_only=True)
+        step = self.step_by_env.get(env_idx, 0)
+        task_plan = self._task_plan_for_execution(env_idx)
+        groups = list(report.metadata.get("groups", ()))
+        semantic_evidence = {
+            "event": trigger,
+            "source_trigger": trigger,
+            "predicate_id": self._semantic_predicate.predicate_id,
+            "observed_value": float(observed_value),
+            "observed_groups": groups,
+            "observed_outcome": report.observed_outcome,
+            "stale_checks": self._semantic_stale_checks_required,
+        }
+        context = HighLevelAgentContext(
+            task_instruction=task_instruction,
+            # Reuse the tightly constrained recovery prompt and guard contract.
+            trigger="no_progress",
+            episode_id=env_idx,
+            timestep=step,
+            frames=frames,
+            robot_state=tuple(
+                np.asarray(observation.get("state", ()), dtype=np.float32)
+                .reshape(-1)
+                .tolist()
+            ),
+            risk=semantic_evidence,
+            current_subgoal=(
+                task_plan.active.step.subgoal
+                if task_plan is not None and task_plan.active is not None
+                else task_instruction
+            ),
+            failure_history=tuple(self._agent_memory_by_env.get(env_idx, ())),
+            memory=tuple(self._agent_memory_by_env.get(env_idx, ())),
+            allowed_intents=(
+                AgentIntent.CONTINUE,
+                AgentIntent.VLA_ACT,
+                AgentIntent.SAFE_STOP,
+            ),
+            remaining_retries=max(
+                0,
+                int(self.model_cfg.get("carve_planner_max_calls_per_episode", 3))
+                - self._high_level_agent.calls_in_episode,
+            ),
+            remaining_recoveries=max(
+                0,
+                self._semantic_max_recoveries - recoveries,
+            ),
+            task_plan=task_plan.to_dict() if task_plan is not None else {},
+        )
+        self._last_planner_step_by_env[env_idx] = step
+        context = self._with_procedural_context(context)
+        planner_result = self._high_level_agent.decide(context)
+        decision = planner_result.decision
+        action = "semantic_planner_fallback_replan"
+        injected_instruction = task_instruction
+        if planner_result.accepted and decision.intent is AgentIntent.VLA_ACT:
+            routed = self._install_routed_planner_guidance(
+                env_idx,
+                str(decision.vla_instruction),
+                calls=int(getattr(self, "_semantic_guidance_calls", 2)),
+            )
+            injected_instruction = self.obs_by_env[env_idx]["lang"]
+            if task_plan is not None:
+                task_plan.select(
+                    subgoal=decision.subgoal,
+                    intent=decision.intent.value,
+                    skill_id=decision.skill_id,
+                )
+            action = (
+                "semantic_subgoal_vla_replan"
+                if routed
+                else "semantic_subgoal_blocked_task_only_replan"
+            )
+        elif planner_result.accepted and decision.intent is AgentIntent.CONTINUE:
+            action = "semantic_planner_continue_original"
+        elif planner_result.accepted and decision.intent is AgentIntent.SAFE_STOP:
+            if bool(getattr(self, "_semantic_safe_stop_enabled", False)):
+                self._safe_stop_envs.add(env_idx)
+                action = "semantic_planner_safe_stop_admitted"
+            else:
+                action = "semantic_planner_safe_stop_rejected_no_authority"
+
+        self._agent_memory_by_env.setdefault(env_idx, []).append(
+            f"step={step} trigger=semantic_planner intent={decision.intent.value} "
+            f"accepted={planner_result.accepted} subgoal={decision.subgoal}"
+        )
+        self._record_planner_row(
+            {
+                "schema_version": "carve.robodojo.semantic-planner.v1",
+                "timestamp_s": time.time(),
+                "env_idx": env_idx,
+                "timestep": step,
+                "trigger": "semantic_no_progress",
+                "role": "vlm_planner",
+                "accepted": planner_result.accepted,
+                "elapsed_ms": planner_result.elapsed_ms,
+                "attempt_count": planner_result.attempt_count,
+                "semantic_evidence": semantic_evidence,
+                "decision": decision.to_dict(),
+                "action": action,
+                "task_instruction": task_instruction,
+                "injected_instruction": injected_instruction,
+                "guidance_calls": (
+                    int(getattr(self, "_semantic_guidance_calls", 2))
+                    if action == "semantic_subgoal_vla_replan"
+                    else 0
+                ),
+                "error": planner_result.error,
+                "validation_errors": list(planner_result.validation_errors),
+                "raw_output": planner_result.raw_output,
+            }
+        )
+        return action
+
+    def _install_routed_planner_guidance(
+        self,
+        env_idx: int,
+        planner_instruction: str,
+        *,
+        calls: int,
+    ) -> bool:
+        """Route Planner text only when the VLA adapter declares support for it."""
+
+        original = getattr(self, "_task_instruction_by_env", {}).get(
+            env_idx,
+            str(self.obs_by_env[env_idx].get("lang", "")),
+        )
+        if not original.strip():
+            raise ValueError("routed VLA guidance requires an original task instruction")
+        if getattr(self, "_vla_instruction_capability", "task_only") == "task_only":
+            getattr(self, "_semantic_guidance_remaining_by_env", {}).pop(
+                env_idx, None
+            )
+            getattr(self, "_semantic_guidance_instruction_by_env", {}).pop(
+                env_idx, None
+            )
+            self.obs_by_env[env_idx]["lang"] = original
+            return False
+        from agentic_vla.runtime import compose_grounded_vla_instruction
+
+        guidance = compose_grounded_vla_instruction(
+            original,
+            planner_instruction=str(planner_instruction),
+        )
+        self._install_semantic_guidance(env_idx, guidance, calls=calls)
+        return True
+
+    def _install_semantic_guidance(
+        self,
+        env_idx: int,
+        instruction: str,
+        *,
+        calls: int,
+    ) -> None:
+        """Persist a bounded recovery instruction across observation refreshes."""
+
+        guidance = str(instruction).strip()
+        if not guidance:
+            raise ValueError("semantic guidance instruction must not be empty")
+        if calls <= 0:
+            raise ValueError("semantic guidance calls must be positive")
+        if not hasattr(self, "_semantic_guidance_remaining_by_env"):
+            self._semantic_guidance_remaining_by_env = {}
+        if not hasattr(self, "_semantic_guidance_instruction_by_env"):
+            self._semantic_guidance_instruction_by_env = {}
+        self._semantic_guidance_remaining_by_env[env_idx] = int(calls)
+        self._semantic_guidance_instruction_by_env[env_idx] = guidance
+        self.obs_by_env[env_idx]["lang"] = guidance
+
+    def _reapply_semantic_guidance(self, env_idx: int) -> None:
+        """Reapply an active recovery instruction after RoboDojo refreshes obs."""
+
+        remaining = getattr(self, "_semantic_guidance_remaining_by_env", {}).get(
+            env_idx, 0
+        )
+        guidance = getattr(self, "_semantic_guidance_instruction_by_env", {}).get(
+            env_idx
+        )
+        if remaining > 0 and guidance:
+            self.obs_by_env[env_idx]["lang"] = guidance
+
+    def _consume_semantic_guidance(self, env_idx: int) -> None:
+        """Retire a temporary Planner subgoal after its bounded VLA budget."""
+
+        remaining = getattr(self, "_semantic_guidance_remaining_by_env", {}).get(
+            env_idx, 0
+        )
+        if remaining <= 0:
+            return
+        remaining -= 1
+        if remaining > 0:
+            self._semantic_guidance_remaining_by_env[env_idx] = remaining
+            return
+
+        self._semantic_guidance_remaining_by_env.pop(env_idx, None)
+        getattr(self, "_semantic_guidance_instruction_by_env", {}).pop(env_idx, None)
+        original = getattr(self, "_task_instruction_by_env", {}).get(env_idx)
+        observation = getattr(self, "obs_by_env", {}).get(env_idx)
+        if original is not None and observation is not None:
+            observation["lang"] = original
+        step = getattr(self, "step_by_env", {}).get(env_idx, 0)
+        getattr(self, "_agent_memory_by_env", {}).setdefault(env_idx, []).append(
+            f"step={step} event=semantic_guidance_expired restored_original_task"
+        )
+        self._record_planner_row(
+            {
+                "schema_version": "carve.robodojo.semantic-guidance.v1",
+                "timestamp_s": time.time(),
+                "env_idx": env_idx,
+                "timestep": step,
+                "action": "restore_original_task",
+                "task_instruction": original,
+            }
+        )
+
+    def _apply_visual_critic(self, env_idx: int, risk: Any) -> None:
+        from agentic_vla.toolchain import VerificationStatus, VisualVerificationContext
+
+        assert self._visual_critic is not None
+        step = self.step_by_env.get(env_idx, 0)
+        disabled_envs = getattr(self, "_visual_critic_disabled_envs", None)
+        if disabled_envs is None:
+            disabled_envs = set()
+            self._visual_critic_disabled_envs = disabled_envs
+        calls_by_env = getattr(self, "_visual_critic_calls_by_env", None)
+        if calls_by_env is None:
+            calls_by_env = {}
+            self._visual_critic_calls_by_env = calls_by_env
+        if env_idx in disabled_envs:
+            return
+        max_calls = int(self.model_cfg.get("carve_planner_max_calls_per_episode", 3))
+        calls = calls_by_env.get(env_idx, 0)
+        if calls >= max_calls:
+            disabled_envs.add(env_idx)
+            self._record_planner_row(
+                {
