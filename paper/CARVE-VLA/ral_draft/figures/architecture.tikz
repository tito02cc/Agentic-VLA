  \fill[amber] (6.24,2.81) circle (0.055);
  \node[anchor=west,text=ink,font=\tiny] at (5.05,2.08)
    {progress / risk event};

  \fill[white,rounded corners=3pt] (7.21,1.93) rectangle (9.40,3.38);
