      "xy_jitter_m": 0.025,
      "yaw_jitter_deg": 35,
      "friction_scale_range": [0.8, 1.2],
      "mass_scale_range": [0.85, 1.15]
    }
  },
  "conditions": {
    "B0_skill_only": "fixed generic grasp and fixed object order",
    "B1_rag_only": "HAA-RAG grasp selection without scene graph or recovery",
