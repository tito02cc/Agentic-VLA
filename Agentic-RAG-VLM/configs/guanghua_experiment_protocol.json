{
  "schema_version": 1,
  "experiment_id": "guanghua_agentic_rag_vlm_dynamic_kitting_v1",
  "claim": "Agentic RAG-VLM improves affordance-conditioned, constraint-aware and recoverable tabletop manipulation on a new robot embodiment without VLA training.",
  "instruction": "Put the red cube in the red target zone and the blue cylinder in the blue target zone without touching the translucent yellow protected glass.",
  "robot": {
    "name": "Guanghua FDR3",
    "primary_arm": "right",
    "controller": "damped-least-squares IK plus joint position control",
    "grasp_synergies": ["power", "pinch", "side"]
  },
  "observation_contract": {
    "public": [
      "front RGB-D",
      "agent RGB-D",
      "right wrist RGB",
      "joint position and velocity",
      "hand actuator state",
      "previous skill outcome derived from public observations"
    ],
    "evaluator_only": [
      "MuJoCo body poses",
      "contact pairs and forces",
      "target-zone membership",
      "injected perturbation metadata",
      "terminal success label"
    ]
  },
  "objects": {
    "red_cube": {
      "body": "cube",
      "free_joint": "cube_free",
      "rest_z_m": 0.834,
      "affordance": "rigid wide body",
      "expected_grasp": "power"
    },
    "blue_cylinder": {
      "body": "blue_cylinder",
      "free_joint": "blue_cylinder_free",
      "rest_z_m": 0.861,
      "affordance": "narrow cylindrical body",
      "expected_grasp": "pinch"
    },
    "fragile_proxy": {
      "body": "fragile_proxy",
      "free_joint": "fragile_proxy_free",
      "rest_z_m": 0.876,
      "display_name": "protected_glass",
      "affordance": "protected fragile obstacle",
      "expected_grasp": "do_not_grasp",
      "semantic_role": "tests whether the planner turns a language-level fragile/do-not-touch instruction into a keep-out relation, approach orientation and clearance constraint"
    }
  },
  "target_zones": {
    "red": {"center_xy_m": [-0.03, -0.23], "half_extent_xy_m": [0.055, 0.055]},
    "blue": {"center_xy_m": [-0.03, -0.05], "half_extent_xy_m": [0.055, 0.055]},
    "staging": {"center_xy_m": [-0.18, 0.13], "half_extent_xy_m": [0.07, 0.07]}
  },
  "scene_families": {
    "G0": {
      "name": "nominal_clear",
      "isolates": "base execution competence",
      "layout_xy_m": {
        "red_cube": [-0.18, -0.23],
        "blue_cylinder": [-0.18, -0.05],
        "fragile_proxy": [0.05, 0.10]
      },
      "xy_jitter_m": 0.01,
      "yaw_jitter_deg": 10
    },
    "G1": {
      "name": "affordance_contrast",
      "isolates": "HAA-RAG grasp selection",
      "layout_xy_m": {
        "red_cube": [-0.18, -0.05],
        "blue_cylinder": [-0.18, -0.23],
        "fragile_proxy": [0.05, 0.10]
      },
      "xy_jitter_m": 0.015,
      "yaw_jitter_deg": 25
    },
    "G2": {
      "name": "fragile_neighbor",
      "isolates": "scene graph and offset approach",
      "layout_xy_m": {
        "red_cube": [-0.18, -0.20],
        "blue_cylinder": [-0.18, -0.03],
        "fragile_proxy": [-0.105, -0.20]
      },
      "xy_jitter_m": 0.008,
      "yaw_jitter_deg": 12
    },
    "G3": {
      "name": "post_plan_displacement",
      "isolates": "execution memory and L3 replan",
      "layout_xy_m": {
        "red_cube": [-0.18, -0.23],
        "blue_cylinder": [-0.18, -0.05],
        "fragile_proxy": [0.05, 0.10]
      },
      "xy_jitter_m": 0.01,
